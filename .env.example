# NexusRelay example configuration
#
# This is the canonical V1 setting inventory and the input template for the
# Phase 2 core Compose profile. `make local-core-up` creates an ignored `.env`
# copy, generates protected development secrets, validates this inventory, and
# starts the healthy localhost deployment.
# Non-empty non-secret values are application defaults unless a
# comment marks them as an example. Empty values are optional unless their
# feature is enabled. Secret file paths are required for the services/commands
# that consume them; create protected regular files before starting those consumers. On Unix,
# sensitive files must not be symlinks or accessible by group/other users (use
# mode 0600 or stricter). Bootstrap values are command-only. This file contains
# no usable production secrets.
# Validate a configured copy and its generated local secrets with:
# go run ./internal/config/cmd/validate-deployment --env-file .env --secret-root .local-secrets
# The explicit file is parsed without shell export syntax or interpolation and
# rejects duplicate, malformed, and unknown keys. Compose runs the same preflight
# before publishing secrets or starting dependencies.

# -----------------------------------------------------------------------------
# Deployment identity and public URLs
# -----------------------------------------------------------------------------

# Exact values: development, test, production. Production enforces HTTPS,
# __Host- session cookies, HTTPS admin origins, and encrypted database transport.
NEXUSRELAY_ENV=development
NEXUSRELAY_VERSION=dev

# Required. Must include /v1. Generated client configurations use this value.
PUBLIC_API_BASE_URL=http://localhost:8080/v1

# Required browser dashboard/control-plane origin.
ADMIN_BASE_URL=http://localhost:8080

# Required hostname routing values must match the URLs above.
PUBLIC_API_HOST=localhost
ADMIN_HOST=localhost

# local: loopback/LAN development, private: private-network profile,
# public: intentionally internet-accessible dashboard.
ADMIN_EXPOSURE_MODE=local

# Comma-separated browser origins allowed to use session-authenticated APIs.
# Must include ADMIN_BASE_URL; every production entry must use HTTPS.
ADMIN_ORIGINS=http://localhost:8080

# Trusted reverse-proxy CIDRs only. Empty means trust no forwarded headers.
TRUSTED_PROXY_CIDRS=

# -----------------------------------------------------------------------------
# Internal service listener and deployment TLS
# -----------------------------------------------------------------------------

# Internal Go service bind inside its container. 0.0.0.0 allows Traefik in a
# separate container to reach the service. External host binding belongs to
# Phase 2 Compose configuration, not this setting.
HTTP_BIND_ADDRESS=0.0.0.0
# Core Compose keeps container listeners on 8080 and uses this value for the
# loopback Traefik host publication. Direct process execution also uses it as
# the listener port.
HTTP_PORT=8080
HTTPS_PORT=8443

# TLS files are required in files mode. The private key must meet the protected
# file rules above; the public certificate may be ordinarily readable. ACME
# email/provider/token are required in
# acme mode. disabled is safe only for local development or trusted external
# termination.
# Supported target modes: disabled, files, acme.
TLS_MODE=disabled
TLS_CERT_FILE=
TLS_KEY_FILE=
ACME_EMAIL=
ACME_DNS_PROVIDER=
ACME_DNS_API_TOKEN_FILE=/run/secrets/acme_dns_api_token

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------

POSTGRES_DB=nexusrelay
# Fixed V1 principal identifier. Validation rejects any other value.
POSTGRES_USER=nexusrelay_cluster_admin
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_cluster_admin_password
DATABASE_HOST=postgres
DATABASE_PORT=5432
# Core validation requires DATABASE_NAME to equal POSTGRES_DB.
DATABASE_NAME=nexusrelay
# The four DATABASE_*_USER values below are fixed V1 identifiers. Validation
# rejects renamed principals. All five password paths and values must be distinct;
# trusted empty-volume PostgreSQL init receives all five, while Atlas and runtime
# processes receive only their own. Runtime loaders ignore other process database
# password settings when a broad env_file exposes their paths; they never read
# those files. Trusted initialization validates that all paths and values differ.
DATABASE_MIGRATION_USER=nexusrelay_migration
DATABASE_MIGRATION_PASSWORD_FILE=/run/secrets/postgres_migration_password
DATABASE_GATEWAY_USER=nexusrelay_gateway
DATABASE_GATEWAY_PASSWORD_FILE=/run/secrets/postgres_gateway_password
DATABASE_CONTROL_PLANE_USER=nexusrelay_control_plane
DATABASE_CONTROL_PLANE_PASSWORD_FILE=/run/secrets/postgres_control_plane_password
DATABASE_WORKER_USER=nexusrelay_worker
DATABASE_WORKER_PASSWORD_FILE=/run/secrets/postgres_worker_password
# Production accepts require, verify-ca, or verify-full. disable is reserved for
# local development/test backends; allow and prefer are rejected.
DATABASE_SSLMODE=disable
DATABASE_MIN_CONNECTIONS_GATEWAY=2
DATABASE_MAX_CONNECTIONS_GATEWAY=30
DATABASE_MIN_CONNECTIONS_CONTROL_PLANE=2
DATABASE_MAX_CONNECTIONS_CONTROL_PLANE=20
DATABASE_MIN_CONNECTIONS_WORKER=2
DATABASE_MAX_CONNECTIONS_WORKER=10
DATABASE_STATEMENT_TIMEOUT=30s
DATABASE_TRANSACTION_TIMEOUT=30s

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------

REDIS_URL_FILE=/run/secrets/redis_url
# Dedicated Redis server bootstrap password. It must be at least 32 base64url
# characters and equal the percent-decoded password in REDIS_URL_FILE.
REDIS_PASSWORD_FILE=/run/secrets/redis_password
REDIS_MAX_CONNECTIONS_GATEWAY=50
REDIS_MAX_CONNECTIONS_CONTROL_PLANE=20
REDIS_MAX_CONNECTIONS_WORKER=20

# Phase 2 infrastructure readiness. Later phases add schema, cryptographic
# fence, Redis Function, and policy-state checks cumulatively.
DEPENDENCY_STARTUP_TIMEOUT=60s
DEPENDENCY_PROBE_TIMEOUT=3s
DEPENDENCY_PROBE_INTERVAL=5s
DEPENDENCY_RETRY_MIN_DELAY=100ms
DEPENDENCY_RETRY_MAX_DELAY=2s

# -----------------------------------------------------------------------------
# Application cryptographic secrets
# -----------------------------------------------------------------------------

# See docs/design/04-providers-secrets.md for key-ring format and rotation.
MASTER_KEYRING_FILE=/run/secrets/provider_master_keyring
API_KEY_PEPPER_RING_FILE=/run/secrets/api_key_pepper_ring
SESSION_SECRET_FILE=/run/secrets/session_secret
CSRF_SECRET_RING_FILE=/run/secrets/csrf_secret_ring

# -----------------------------------------------------------------------------
# Authentication and browser sessions
# -----------------------------------------------------------------------------

# Use a normal name for HTTP localhost. Production HTTPS deployments should use
# a __Host- prefixed cookie name with Secure, Path=/, and no Domain attribute.
SESSION_COOKIE_NAME=nexusrelay_session
SESSION_IDLE_TTL=12h
SESSION_ABSOLUTE_TTL=168h
SESSION_LAST_SEEN_WRITE_INTERVAL=5m
PASSWORD_ARGON2_MEMORY_KIB=65536
PASSWORD_ARGON2_ITERATIONS=3
PASSWORD_ARGON2_PARALLELISM=2

# -----------------------------------------------------------------------------
# Gateway request and upstream timeout policy
# -----------------------------------------------------------------------------

REQUEST_BODY_MAX_BYTES=10485760
UPSTREAM_CONNECT_TIMEOUT=10s
UPSTREAM_FIRST_BYTE_TIMEOUT=60s
UPSTREAM_IDLE_TIMEOUT=60s
UPSTREAM_TOTAL_TIMEOUT=10m
SHUTDOWN_GRACE_PERIOD=30s
MAX_UPSTREAM_ATTEMPTS=3

# -----------------------------------------------------------------------------
# Logging, metrics, and tracing
# -----------------------------------------------------------------------------

LOG_LEVEL=info
LOG_FORMAT=json
# Exposes /metrics on each Go service's internal listener. Traefik does not route
# this path, and the core profile publishes no Go service port to the host.
METRICS_ENABLED=true
# Traces are disabled unless explicitly enabled. NexusRelay exports traces only;
# it does not bundle or require a collector. The endpoint is an unauthenticated
# HTTP(S) OTLP traces URL with no userinfo, query, or fragment, for example
# http://collector:4318/v1/traces. Fixed parent-based always-on sampling applies
# only while tracing is enabled.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# -----------------------------------------------------------------------------
# Retention and worker scheduling
# -----------------------------------------------------------------------------

REQUEST_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
HEALTH_OBSERVATION_RETENTION_DAYS=14
PROCESSED_OUTBOX_RETENTION_DAYS=7
ANALYTICS_TARGET_LAG=5m
STALE_REQUEST_RECONCILIATION_INTERVAL=1m
WORKER_CONCURRENCY=4
OUTBOX_LEASE_DURATION=30s
OUTBOX_RETRY_BASE_DELAY=1s
OUTBOX_RETRY_MAX_DELAY=5m
HEALTH_PROBE_INTERVAL=1m
HEALTH_FAST_WINDOW=5m
HEALTH_STABILIZING_WINDOW=30m
HEALTH_MIN_SAMPLES=20
HEALTH_POLICY_VERSION=1
# Enter unavailable below this success-rate threshold or after the configured
# consecutive active failures. Recover only at/above the higher exit threshold
# plus the configured consecutive active successes.
HEALTH_UNAVAILABLE_ENTRY_THRESHOLD_BPS=5000
HEALTH_UNAVAILABLE_EXIT_THRESHOLD_BPS=9000
HEALTH_CONSECUTIVE_FAILURES=3
HEALTH_CONSECUTIVE_SUCCESSES=3
RETENTION_BATCH_SIZE=1000

# -----------------------------------------------------------------------------
# Coding-agent configuration export
# -----------------------------------------------------------------------------

AGENT_API_KEY_ENV=NEXUSRELAY_API_KEY
OPENCODE_PROVIDER_ID=nexusrelay
OPENCODE_PROVIDER_NAME=NexusRelay

# -----------------------------------------------------------------------------
# Optional Cloudflare Tunnel public API profile
# -----------------------------------------------------------------------------

# Enabling this profile requires PUBLIC_API_BASE_URL=https://<host>/v1,
# PUBLIC_API_HOST=<host>, a distinct ADMIN_HOST, TLS_MODE=acme,
# ACME_DNS_PROVIDER=cloudflare, and ACME_EMAIL. Start it explicitly with the
# `core` and `cloudflare` Compose profiles; the default core remains independent.
ENABLE_CLOUDFLARE_TUNNEL=false
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_CREDENTIALS_FILE=/run/secrets/cloudflare_tunnel_credentials.json

# The public tunnel profile derives its hostname from PUBLIC_API_BASE_URL.
# PUBLIC_API_HOST and ADMIN_HOST must differ, so public tunnel ingress can never
# publish the dashboard/control-plane host, including private-admin deployments.
# Keep the named tunnel credential JSON and ACME DNS token in the ignored
# `.cloudflare-secrets/` directory described by the Cloudflare runbook. They are
# published into separate service-specific named volumes and never mounted from
# the host into cloudflared or Traefik.

# -----------------------------------------------------------------------------
# Optional Tailscale + CoreDNS private dashboard profile
# -----------------------------------------------------------------------------

ENABLE_TAILSCALE_PRIVATE_ADMIN=false
TAILSCALE_AUTH_KEY_FILE=/run/secrets/tailscale_auth_key
TAILSCALE_STATE_DIR=/var/lib/tailscale
TAILSCALE_HOSTNAME=nexusrelay

# Candidate defaults for ADR 0002 feasibility and authenticated acceptance.
# Deployment validation continues to reject profile enablement until ADR 0002
# is Accepted. Replace these together if they overlap deployment networks.
PRIVATE_INGRESS_SUBNET=172.30.0.0/24
PRIVATE_TRAEFIK_IP=172.30.0.10
PRIVATE_DNS_IP=172.30.0.53
TAILSCALE_ADVERTISE_ROUTES=172.30.0.10/32,172.30.0.53/32

# -----------------------------------------------------------------------------
# Bootstrap
# -----------------------------------------------------------------------------

# Bootstrap values are consumed only by the explicit one-time bootstrap command.
# Do not pass BOOTSTRAP_* settings, including empty values, to long-running
# services: their startup validation rejects command-only settings.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_ORGANIZATION_NAME=
BOOTSTRAP_ORGANIZATION_SLUG=
BOOTSTRAP_PASSWORD_FILE=/run/secrets/bootstrap_password
