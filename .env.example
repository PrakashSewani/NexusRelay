# NexusRelay example configuration
#
# This is the canonical V1 setting inventory and the core Compose development
# profile. Non-empty non-secret values are application defaults unless a comment
# marks them as an example. Empty values are optional unless their feature is
# enabled. Secret file paths are required for the services/commands that consume
# them; create protected files before starting those consumers. Bootstrap values
# are command-only. This file contains no usable production secrets.

# -----------------------------------------------------------------------------
# Deployment identity and public URLs
# -----------------------------------------------------------------------------

NEXUSRELAY_ENV=development
NEXUSRELAY_VERSION=dev

# Required. Must include /v1. Generated client configurations use this value.
PUBLIC_API_BASE_URL=http://localhost:8080/v1

# Required browser dashboard/control-plane origin.
ADMIN_BASE_URL=http://localhost:8080

# Required hostname routing values must match the URLs above.
PUBLIC_API_HOST=localhost
ADMIN_HOST=localhost

# local: loopback/LAN development, private: private-network profile,
# public: intentionally internet-accessible dashboard.
ADMIN_EXPOSURE_MODE=local

# Comma-separated browser origins allowed to use session-authenticated APIs.
ADMIN_ORIGINS=http://localhost:8080

# Trusted reverse-proxy CIDRs only. Empty means trust no forwarded headers.
TRUSTED_PROXY_CIDRS=

# -----------------------------------------------------------------------------
# Local Traefik bindings and TLS
# -----------------------------------------------------------------------------

HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443

# TLS files are required in files mode. ACME email/provider/token are required in
# acme mode. disabled is safe only for local development or trusted external
# termination.
# Supported target modes: disabled, files, acme.
TLS_MODE=disabled
TLS_CERT_FILE=
TLS_KEY_FILE=
ACME_EMAIL=
ACME_DNS_PROVIDER=
ACME_DNS_API_TOKEN_FILE=/run/secrets/acme_dns_api_token

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------

POSTGRES_DB=nexusrelay
POSTGRES_USER=nexusrelay
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=nexusrelay
DATABASE_USER=nexusrelay
DATABASE_PASSWORD_FILE=/run/secrets/postgres_password
DATABASE_SSLMODE=disable
DATABASE_MIN_CONNECTIONS_GATEWAY=2
DATABASE_MAX_CONNECTIONS_GATEWAY=30
DATABASE_MIN_CONNECTIONS_CONTROL_PLANE=2
DATABASE_MAX_CONNECTIONS_CONTROL_PLANE=20
DATABASE_MIN_CONNECTIONS_WORKER=2
DATABASE_MAX_CONNECTIONS_WORKER=10
DATABASE_STATEMENT_TIMEOUT=30s
DATABASE_TRANSACTION_TIMEOUT=30s

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------

REDIS_URL_FILE=/run/secrets/redis_url
REDIS_MAX_CONNECTIONS_GATEWAY=50
REDIS_MAX_CONNECTIONS_CONTROL_PLANE=20
REDIS_MAX_CONNECTIONS_WORKER=20

# -----------------------------------------------------------------------------
# Application cryptographic secrets
# -----------------------------------------------------------------------------

# See docs/design/04-providers-secrets.md for key-ring format and rotation.
MASTER_KEYRING_FILE=/run/secrets/provider_master_keyring
API_KEY_PEPPER_RING_FILE=/run/secrets/api_key_pepper_ring
SESSION_SECRET_FILE=/run/secrets/session_secret
CSRF_SECRET_FILE=/run/secrets/csrf_secret

# -----------------------------------------------------------------------------
# Authentication and browser sessions
# -----------------------------------------------------------------------------

# Use a normal name for HTTP localhost. Production HTTPS deployments should use
# a __Host- prefixed cookie name with Secure, Path=/, and no Domain attribute.
SESSION_COOKIE_NAME=nexusrelay_session
SESSION_IDLE_TTL=12h
SESSION_ABSOLUTE_TTL=168h
SESSION_LAST_SEEN_WRITE_INTERVAL=5m
PASSWORD_ARGON2_MEMORY_KIB=65536
PASSWORD_ARGON2_ITERATIONS=3
PASSWORD_ARGON2_PARALLELISM=2

# -----------------------------------------------------------------------------
# Gateway request and upstream timeout policy
# -----------------------------------------------------------------------------

REQUEST_BODY_MAX_BYTES=10485760
UPSTREAM_CONNECT_TIMEOUT=10s
UPSTREAM_FIRST_BYTE_TIMEOUT=60s
UPSTREAM_IDLE_TIMEOUT=60s
UPSTREAM_TOTAL_TIMEOUT=10m
SHUTDOWN_GRACE_PERIOD=30s
MAX_UPSTREAM_ATTEMPTS=3

# -----------------------------------------------------------------------------
# Logging, metrics, and tracing
# -----------------------------------------------------------------------------

LOG_LEVEL=info
LOG_FORMAT=json
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# -----------------------------------------------------------------------------
# Retention and worker scheduling
# -----------------------------------------------------------------------------

REQUEST_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
HEALTH_OBSERVATION_RETENTION_DAYS=14
PROCESSED_OUTBOX_RETENTION_DAYS=7
ANALYTICS_TARGET_LAG=5m
STALE_REQUEST_RECONCILIATION_INTERVAL=1m
WORKER_CONCURRENCY=4
OUTBOX_LEASE_DURATION=30s
OUTBOX_RETRY_BASE_DELAY=1s
OUTBOX_RETRY_MAX_DELAY=5m
HEALTH_PROBE_INTERVAL=1m
HEALTH_FAST_WINDOW=5m
HEALTH_STABILIZING_WINDOW=30m
HEALTH_MIN_SAMPLES=20
HEALTH_POLICY_VERSION=1
RETENTION_BATCH_SIZE=1000

# -----------------------------------------------------------------------------
# Coding-agent configuration export
# -----------------------------------------------------------------------------

AGENT_API_KEY_ENV=NEXUSRELAY_API_KEY
OPENCODE_PROVIDER_ID=nexusrelay
OPENCODE_PROVIDER_NAME=NexusRelay

# -----------------------------------------------------------------------------
# Optional Cloudflare Tunnel public API profile
# -----------------------------------------------------------------------------

ENABLE_CLOUDFLARE_TUNNEL=false
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_CREDENTIALS_FILE=/run/secrets/cloudflare_tunnel_credentials.json

# The public tunnel profile derives its hostname from PUBLIC_API_BASE_URL and
# must never publish ADMIN_HOST when ADMIN_EXPOSURE_MODE=private.

# -----------------------------------------------------------------------------
# Optional Tailscale + CoreDNS private dashboard profile
# -----------------------------------------------------------------------------

ENABLE_TAILSCALE_PRIVATE_ADMIN=false
TAILSCALE_AUTH_KEY_FILE=/run/secrets/tailscale_auth_key
TAILSCALE_STATE_DIR=/var/lib/tailscale
TAILSCALE_HOSTNAME=nexusrelay

# Example defaults for the proposed reference profile. They are consumed only
# when ENABLE_TAILSCALE_PRIVATE_ADMIN=true and must be replaced if they overlap
# deployment networks.
PRIVATE_INGRESS_SUBNET=172.30.0.0/24
PRIVATE_TRAEFIK_IP=172.30.0.10
PRIVATE_DNS_IP=172.30.0.53
TAILSCALE_ADVERTISE_ROUTES=172.30.0.10/32,172.30.0.53/32

# -----------------------------------------------------------------------------
# Bootstrap
# -----------------------------------------------------------------------------

# Bootstrap values are consumed only by the explicit one-time bootstrap command.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_ORGANIZATION_NAME=
BOOTSTRAP_ORGANIZATION_SLUG=
BOOTSTRAP_PASSWORD_FILE=/run/secrets/bootstrap_password
